        "zombiesKilled": {"description": "The game's own kill count, getZombieKills.", "type": "integer"},
        "via": {"description": "Which signal raised it: hook (OnPlayerDeath named this player) or isDead (the player's isDead read true first).", "type": "string"}
      },
      "required": ["worldAge", "x", "y", "z", "health", "zombiesKilled", "via"]
    },

