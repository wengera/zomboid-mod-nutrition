{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pza1.json",
  "title": "PZA/1",
  "description": "The one source of the PZAgent protocol PZA/1 (Plan 22 spec section 4); tools/pza_schema.py generates the Lua header, the Python module and the LLM tool descriptions from it. A definition whose x-encoding is positional describes the decoded object; on the wire its values travel as a JSON array in x-order, a kind's array opening with the kind string. A group's fields are only appended at the end of its x-order (PZA/1.1, PZAgent 1.1: me and cost; PZA/1.2, PZAgent 1.2: me's hour and the square record's edges; PZA/1.3, PZAgent 1.3: the death event), so a reader tolerates appended fields: a group or record array from its x-prior arity up to its x-order decodes with the trailing fields null.",
  "x-proto": "PZA/1",
  "x-kinds": ["hello", "frame", "map", "event", "act", "reply"],
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/frame"},
    {"$ref": "#/$defs/map"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/act"},
    {"$ref": "#/$defs/reply"}
  ],
  "$defs": {
    "gait": {
      "description": "The gait a move runs at.",
      "type": "string",
      "enum": ["walk", "run", "sprint"]
    },
    "ikind": {
      "description": "What an interact does to its square's object.",
      "type": "string",
      "enum": ["open", "close", "loot"]
    },
    "filter": {
      "description": "Which items a loot takes.",
      "type": "string",
      "enum": ["food", "water", "weapon", "bandage", "all"]
    },
    "itemUse": {
      "description": "An item's use as the engine answers it.",
      "type": "string",
      "enum": ["food", "water", "weapon", "bandage", "other"]
    },
    "actionType": {
      "description": "A skill type a cmd line names.",
      "type": "string",
      "enum": ["walkTo", "steer", "attack", "interact", "equip", "consume", "drop", "stop", "scan", "rate", "sleep"]
    },
    "actState": {
      "description": "A skill's lifecycle state.",
      "type": "string",
      "enum": ["accepted", "rejected", "progress", "done", "failed"]
    },
    "reason": {
      "description": "The closed set of reasons a skill is rejected or fails with.",
      "type": "string",
      "enum": ["bad args", "unknown type", "dead", "no square", "no path", "stuck", "superseded", "not loaded", "no target", "no weapon", "out of reach", "no door", "locked", "not adjacent", "no container", "empty", "no match", "none held", "not valid", "interrupted", "not safe", "not allowed"]
    },
    "eventKind": {
      "description": "The kind of an engine event line.",
      "type": "string",
      "enum": ["damage", "swing", "zombie_dead", "item_added", "item_removed", "door", "lua_error", "overflow", "scan_dropped", "death"]
    },
    "mapMode": {
      "description": "Whether a map scan sends every square in range or only the changed ones.",
      "type": "string",
      "enum": ["full", "delta"]
    },
    "linkMode": {
      "description": "How the mod writes its out file.",
      "type": "string",
      "enum": ["append", "chunk"]
    },
    "side": {
      "description": "The side whose listener saw a damage event.",
      "type": "string",
      "enum": ["client", "server"]
    },

    "hello": {
      "description": "The first line of a session: the protocol, the mod and what it accepts.",
      "x-role": "kind",
      "x-encoding": "keyed",
      "type": "object",
      "properties": {
        "kind": {"description": "The line kind.", "const": "hello"},
        "seq": {"description": "The envelope: the line's sequence number.", "type": "integer"},
        "tick": {"description": "The envelope: the client tick the line was written on.", "type": "integer"},
        "wallMs": {"description": "The envelope: the client's wall clock in epoch milliseconds.", "type": "integer"},
        "proto": {"description": "The protocol name.", "const": "PZA/1"},
        "mod": {"description": "The mod version.", "type": "string"},
        "build": {"description": "The game build the client reports.", "type": "string"},
        "user": {"description": "The client's user name.", "type": "string"},
        "rate": {"description": "The frame rate in frames a second.", "type": "number"},
        "caps": {"description": "The skill types this build accepts.", "type": "array", "items": {"$ref": "#/$defs/actionType"}},
        "mode": {"description": "How the mod writes its out file.", "$ref": "#/$defs/linkMode"}
      },
      "required": ["kind", "seq", "tick", "wallMs", "proto", "mod", "build", "user", "rate", "caps", "mode"]
    },

    "frame": {
      "description": "One observation of the player, sent every frame, a delta eliding unchanged groups as true.",
      "x-role": "kind",
      "x-encoding": "positional",
      "x-order": ["kind", "seq", "tick", "wallMs", "gameMin", "worldAge", "me", "stats", "body", "load", "weapon", "action", "act", "zombies", "cost"],
      "type": "object",
      "properties": {
        "kind": {"description": "The line kind.", "const": "frame"},
        "seq": {"description": "The line's sequence number.", "type": "integer"},
        "tick": {"description": "The client tick the line was written on.", "type": "integer"},
        "wallMs": {"description": "The client's wall clock in milliseconds.", "type": "number"},
        "gameMin": {"description": "The game clock in minutes.", "type": "number"},
        "worldAge": {"description": "The world age in hours.", "type": "number"},
        "me": {"description": "The player's position and gait.", "$ref": "#/$defs/me"},
        "stats": {"description": "The player's character stats.", "$ref": "#/$defs/stats"},
        "body": {"description": "The player's health and wounds.", "$ref": "#/$defs/body"},
        "load": {"description": "The player's carried weight and its moodle level.", "$ref": "#/$defs/load"},
        "weapon": {"description": "The primary hand weapon, null when none.", "anyOf": [{"$ref": "#/$defs/weapon"}, {"type": "null"}]},
        "action": {"description": "The current timed action, null when none.", "anyOf": [{"$ref": "#/$defs/action"}, {"type": "null"}]},
        "act": {"description": "The current skill, null when none.", "anyOf": [{"$ref": "#/$defs/act_now"}, {"type": "null"}]},
        "zombies": {"description": "The zombies in sense range, nearest first.", "type": "array", "items": {"$ref": "#/$defs/zombie"}},
        "cost": {"description": "The mod's own cost on the client.", "$ref": "#/$defs/cost"}
      },
      "required": ["kind", "seq", "tick", "wallMs", "gameMin", "worldAge", "me", "stats", "body", "load", "weapon", "action", "act", "zombies", "cost"]
    },
    "me": {
      "description": "The player's position and gait.",
      "x-role": "group",
      "x-group": "me",
      "x-encoding": "positional",
      "x-prior": 11,
      "x-order": ["x", "y", "z", "dir", "pace", "moving", "running", "sprinting", "forceRun", "forceSprint", "autoWalk", "zombiesSeen", "zombiesListed", "hour"],
      "type": "object",
      "properties": {
        "x": {"description": "The world x in tiles.", "type": "number"},
        "y": {"description": "The world y in tiles.", "type": "number"},
        "z": {"description": "The floor level.", "type": "number"},
        "dir": {"description": "The facing direction name.", "type": "string"},
        "pace": {"description": "The measured pace in tiles a second.", "type": "number"},
        "moving": {"description": "Whether the player is moving.", "type": "boolean"},
        "running": {"description": "Whether the running flag is set.", "type": "boolean"},
        "sprinting": {"description": "Whether the sprinting flag is set.", "type": "boolean"},
        "forceRun": {"description": "The force-run flag read after the frame.", "type": "boolean"},
        "forceSprint": {"description": "The force-sprint flag read after the frame.", "type": "boolean"},
        "autoWalk": {"description": "Whether auto-walk is on.", "type": "boolean"},
        "zombiesSeen": {"description": "The cell's zombie list size, the frame's one walk.", "type": "integer"},
        "zombiesListed": {"description": "The zombies the frame lists, those alive within the sense radius.", "type": "integer"},
        "hour": {"description": "The game's hour of day, 0 to 24, as a number.", "type": "number"}
      },
      "required": ["x", "y", "z", "dir", "pace", "moving", "running", "sprinting", "forceRun", "forceSprint", "autoWalk", "zombiesSeen", "zombiesListed", "hour"]
    },
    "stats": {
      "description": "The player's character stats.",
      "x-role": "group",
      "x-group": "stats",
      "x-encoding": "positional",
      "x-order": ["hunger", "thirst", "fatigue", "endurance", "panic", "pain", "sickness", "wetness", "temperature"],
      "type": "object",
      "properties": {
        "hunger": {"description": "The hunger stat.", "type": "number"},
        "thirst": {"description": "The thirst stat.", "type": "number"},
        "fatigue": {"description": "The fatigue stat.", "type": "number"},
        "endurance": {"description": "The endurance stat.", "type": "number"},
        "panic": {"description": "The panic stat.", "type": "number"},
        "pain": {"description": "The pain stat.", "type": "number"},
        "sickness": {"description": "The food sickness stat.", "type": "number"},
        "wetness": {"description": "The wetness stat.", "type": "number"},
        "temperature": {"description": "The body temperature in degrees Celsius.", "type": "number"}
      },
      "required": ["hunger", "thirst", "fatigue", "endurance", "panic", "pain", "sickness", "wetness", "temperature"]
    },
    "body": {
      "description": "The player's health and wounds.",
      "x-role": "group",
      "x-group": "body",
      "x-encoding": "positional",
      "x-order": ["health", "bleeding", "scratched", "bitten", "parts"],
      "type": "object",
      "properties": {
        "health": {"description": "The overall body health.", "type": "number"},
        "bleeding": {"description": "The number of bleeding parts.", "type": "integer"},
        "scratched": {"description": "The number of scratched parts.", "type": "integer"},
        "bitten": {"description": "The number of bitten parts.", "type": "integer"},
        "parts": {"description": "The body parts below full health.", "type": "array", "items": {"$ref": "#/$defs/part"}}
      },
      "required": ["health", "bleeding", "scratched", "bitten", "parts"]
    },
    "load": {
      "description": "The player's carried weight and its moodle level.",
      "x-role": "group",
      "x-group": "load",
      "x-encoding": "positional",
      "x-order": ["weight", "max", "level", "n"],
      "type": "object",
      "properties": {
        "weight": {"description": "The carried weight.", "type": "number"},
        "max": {"description": "The maximum carry weight.", "type": "number"},
        "level": {"description": "The heavy-load moodle level.", "type": "integer"},
        "n": {"description": "The number of inventory items.", "type": "integer"}
      },
      "required": ["weight", "max", "level", "n"]
    },
    "weapon": {
      "description": "The primary hand weapon.",
      "x-role": "group",
      "x-group": "weapon",
      "x-encoding": "positional",
      "x-order": ["type", "cond", "reach", "ammo"],
      "type": "object",
      "properties": {
        "type": {"description": "The weapon's full type.", "type": "string"},
        "cond": {"description": "The weapon's condition.", "type": "number"},
        "reach": {"description": "The engine's reach, max range times range mod.", "type": "number"},
        "ammo": {"description": "The loaded ammunition count, null for a melee weapon.", "type": ["integer", "null"]}
      },
      "required": ["type", "cond", "reach", "ammo"]
    },
    "action": {
      "description": "The current timed action.",
      "x-role": "group",
      "x-group": "action",
      "x-encoding": "positional",
      "x-order": ["class", "n"],
      "type": "object",
      "properties": {
        "class": {"description": "The head action's Type.", "type": "string"},
        "n": {"description": "The number of queued actions.", "type": "integer"}
      },
      "required": ["class", "n"]
    },
    "act_now": {
      "description": "The current skill.",
      "x-role": "group",
      "x-group": "act",
      "x-encoding": "positional",
      "x-order": ["aid", "state"],
      "type": "object",
      "properties": {
        "aid": {"description": "The skill's action id.", "type": "string"},
        "state": {"description": "The skill's state.", "$ref": "#/$defs/actState"}
      },
      "required": ["aid", "state"]
    },
    "cost": {
      "description": "The mod's own cost on the client.",
      "x-role": "group",
      "x-group": "cost",
      "x-encoding": "positional",
      "x-prior": 8,
      "x-order": ["tickMs", "actMs", "senseMs", "mapMs", "linkMs", "tickMaxMs", "over5", "dropped", "pollMs", "startMs", "maxActMs", "maxSenseMs", "maxMapMs", "maxLinkMs", "maxPollMs", "maxStartMs"],
      "type": "object",
      "properties": {
        "tickMs": {"description": "The previous tick's whole body in ms (a single tick on the 1 ms clock).", "type": "number"},
        "actMs": {"description": "This tick's skill tick in ms (a single tick).", "type": "number"},
        "senseMs": {"description": "This tick's events and frame read in ms (a single tick).", "type": "number"},
        "mapMs": {"description": "This tick's scan or watch step in ms (a single tick).", "type": "number"},
        "linkMs": {"description": "The previous tick's flush in ms.", "type": "number"},
        "tickMaxMs": {"description": "The worst body since the last frame, in ms.", "type": "number"},
        "over5": {"description": "The bodies of 5 ms or more since the last frame.", "type": "integer"},
        "dropped": {"description": "The number of lines dropped.", "type": "integer"},
        "pollMs": {"description": "This tick's command poll in ms, the ack write included (a single tick).", "type": "number"},
        "startMs": {"description": "This tick's command start in ms, Main's scan or rate answer or the runner's start (a single tick).", "type": "number"},
        "maxActMs": {"description": "The worst skill tick since the last frame, in ms.", "type": "number"},
        "maxSenseMs": {"description": "The worst events and frame read since the last frame, in ms.", "type": "number"},
        "maxMapMs": {"description": "The worst scan or watch step since the last frame, in ms.", "type": "number"},
        "maxLinkMs": {"description": "The worst flush since the last frame, in ms.", "type": "number"},
        "maxPollMs": {"description": "The worst command poll since the last frame, in ms.", "type": "number"},
        "maxStartMs": {"description": "The worst command start since the last frame, in ms.", "type": "number"}
      },
      "required": ["tickMs", "actMs", "senseMs", "mapMs", "linkMs", "tickMaxMs", "over5", "dropped", "pollMs", "startMs", "maxActMs", "maxSenseMs", "maxMapMs", "maxLinkMs", "maxPollMs", "maxStartMs"]
    },
    "part": {
      "description": "One body part below full health.",
      "x-role": "record",
      "x-encoding": "positional",
      "x-order": ["i", "h"],
      "type": "object",
      "properties": {
        "i": {"description": "The body part index.", "type": "integer"},
        "h": {"description": "The body part's health.", "type": "number"}
      },
      "required": ["i", "h"]
    },
    "zombie": {
      "description": "One zombie in sense range.",
      "x-role": "record",
      "x-encoding": "positional",
      "x-order": ["id", "x", "y", "dist", "hasTarget", "crawler", "health"],
      "type": "object",
      "properties": {
        "id": {"description": "The zombie's online id.", "type": "integer"},
        "x": {"description": "The world x in tiles.", "type": "number"},
        "y": {"description": "The world y in tiles.", "type": "number"},
        "dist": {"description": "The distance from the player in tiles.", "type": "number"},
        "hasTarget": {"description": "Whether the zombie has a target.", "type": "boolean"},
        "crawler": {"description": "Whether the zombie crawls.", "type": "boolean"},
        "health": {"description": "The zombie's health.", "type": "number"}
      },
      "required": ["id", "x", "y", "dist", "hasTarget", "crawler", "health"]
    },

    "map": {
      "description": "One part of a map scan: the squares it carries by position.",
      "x-role": "kind",
      "x-encoding": "positional",
      "x-order": ["kind", "seq", "tick", "wallMs", "mode", "scanId", "part", "parts", "squares", "missing"],
      "type": "object",
      "properties": {
        "kind": {"description": "The line kind.", "const": "map"},
        "seq": {"description": "The line's sequence number.", "type": "integer"},
        "tick": {"description": "The client tick the line was written on.", "type": "integer"},
        "wallMs": {"description": "The client's wall clock in milliseconds.", "type": "number"},
        "mode": {"description": "A full scan or a delta of changed squares.", "$ref": "#/$defs/mapMode"},
        "scanId": {"description": "The scan this part belongs to.", "type": "integer"},
        "part": {"description": "This part's number, from 1.", "type": "integer"},
        "parts": {"description": "The scan's number of parts.", "type": "integer"},
        "squares": {"description": "The squares this part carries.", "type": "array", "items": {"$ref": "#/$defs/square"}},
        "missing": {"description": "The Java member names the scan could not read on this part.", "type": "array", "items": {"type": "string"}}
      },
      "required": ["kind", "seq", "tick", "wallMs", "mode", "scanId", "part", "parts", "squares", "missing"]
    },
    "square": {
      "description": "One grid square.",
      "x-role": "record",
      "x-encoding": "positional",
      "x-prior": 12,
      "x-order": ["x", "y", "z", "solid", "solidTrans", "light", "room", "building", "door", "window", "containers", "floor", "blockN", "blockW", "edgeN", "edgeW"],
      "type": "object",
      "properties": {
        "x": {"description": "The square's x.", "type": "integer"},
        "y": {"description": "The square's y.", "type": "integer"},
        "z": {"description": "The square's floor level.", "type": "integer"},
        "solid": {"description": "Whether the square blocks movement.", "type": "boolean"},
        "solidTrans": {"description": "Whether the square blocks movement but not sight.", "type": "boolean"},
        "light": {"description": "The square's light level.", "type": "number"},
        "room": {"description": "The room name, null outside.", "type": ["string", "null"]},
        "building": {"description": "The building id, null outside.", "type": ["integer", "null"]},
        "door": {"description": "The square's door, null when none.", "anyOf": [{"$ref": "#/$defs/portal"}, {"type": "null"}]},
        "window": {"description": "The square's window, null when none.", "anyOf": [{"$ref": "#/$defs/portal"}, {"type": "null"}]},
        "containers": {"description": "The square's containers.", "type": "array", "items": {"$ref": "#/$defs/container"}},
        "floor": {"description": "The full types of the items on the floor.", "type": "array", "items": {"type": "string"}},
        "blockN": {"description": "Whether a step from this square to its north neighbour is blocked: a collide flag with no window, a closed or barricaded door, an intact closed or barricaded window, or a stair top (isBlockedTo).", "type": "boolean"},
        "blockW": {"description": "Whether a step from this square to its west neighbour is blocked: a collide flag with no window, a closed or barricaded door, an intact closed or barricaded window, or a stair top (isBlockedTo).", "type": "boolean"},
        "edgeN": {"description": "Whether a wall, door or window stands on the north edge, open or closed (isSomethingTo).", "type": "boolean"},
        "edgeW": {"description": "Whether a wall, door or window stands on the west edge, open or closed (isSomethingTo).", "type": "boolean"}
      },
      "required": ["x", "y", "z", "solid", "solidTrans", "light", "room", "building", "door", "window", "containers", "floor", "blockN", "blockW", "edgeN", "edgeW"]
    },
    "portal": {
      "description": "A door or a window.",
      "x-role": "record",
      "x-encoding": "positional",
      "x-order": ["open", "locked", "barricaded"],
      "type": "object",
      "properties": {
        "open": {"description": "Whether it is open.", "type": "boolean"},
        "locked": {"description": "Whether it is locked.", "type": "boolean"},
        "barricaded": {"description": "Whether it is barricaded.", "type": "boolean"}
      },
      "required": ["open", "locked", "barricaded"]
    },
    "container": {
      "description": "One container on a square.",
      "x-role": "record",
      "x-encoding": "positional",
      "x-order": ["type", "n", "items"],
      "type": "object",
      "properties": {
        "type": {"description": "The container type.", "type": "string"},
        "n": {"description": "The number of items in it.", "type": "integer"},
        "items": {"description": "The full types of the items in it.", "type": "array", "items": {"type": "string"}}
      },
      "required": ["type", "n", "items"]
    },

    "event": {
      "description": "One engine event, under the seq, tick and wallMs envelope every line carries; the per-kind fields sit flat beside event and gameMin.",
      "x-role": "kind",
      "x-encoding": "keyed",
      "type": "object",
      "properties": {
        "kind": {"description": "The line kind.", "const": "event"},
        "seq": {"description": "The envelope: the line's sequence number.", "type": "integer"},
        "tick": {"description": "The envelope: the client tick the line was written on.", "type": "integer"},
        "wallMs": {"description": "The envelope: the client's wall clock in epoch milliseconds.", "type": "integer"},
        "event": {"description": "The event's kind.", "$ref": "#/$defs/eventKind"},
        "gameMin": {"description": "The game clock in minutes when the event fired.", "type": "number"}
      },
      "required": ["kind", "seq", "tick", "wallMs", "event", "gameMin"],
      "oneOf": [
        {"$ref": "#/$defs/event_damage"},
        {"$ref": "#/$defs/event_swing"},
        {"$ref": "#/$defs/event_zombie_dead"},
        {"$ref": "#/$defs/event_item_added"},
        {"$ref": "#/$defs/event_item_removed"},
        {"$ref": "#/$defs/event_door"},
        {"$ref": "#/$defs/event_lua_error"},
        {"$ref": "#/$defs/event_overflow"},
        {"$ref": "#/$defs/event_scan_dropped"},
        {"$ref": "#/$defs/event_death"}
      ]
    },
    "event_damage": {
      "description": "The player took body damage.",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "damage"},
        "tag": {"description": "The engine's damage type tag.", "type": "string"},
        "amount": {"description": "The damage amount.", "type": "number"},
        "side": {"description": "The side whose listener saw it.", "$ref": "#/$defs/side"}
      },
      "required": ["tag", "amount", "side"]
    },
    "event_swing": {
      "description": "The player swung a weapon.",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "swing"},
        "attackStarted": {"description": "Whether the engine started the attack.", "type": "boolean"},
        "meleeDelay": {"description": "The melee delay after the swing.", "type": "number"}
      },
      "required": ["attackStarted", "meleeDelay"]
    },
    "event_zombie_dead": {
      "description": "A zombie died.",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "zombie_dead"},
        "id": {"description": "The zombie's online id.", "type": "integer"}
      },
      "required": ["id"]
    },
    "event_item_added": {
      "description": "An item entered the inventory.",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "item_added"},
        "itemId": {"description": "The item's id.", "type": "integer"},
        "fullType": {"description": "The item's full type.", "type": "string"},
        "weight": {"description": "The item's weight.", "type": "number"},
        "use": {"description": "The item's use as the engine answers it: food (isA Food), water (a drinkable fluid container), weapon (isA HandWeapon), bandage (a Bandage or Rag by full type), else other. Absent in logs written before Plan 23 Task 9b.", "$ref": "#/$defs/itemUse"}
      },
      "required": ["itemId", "fullType", "weight"]
    },
    "event_item_removed": {
      "description": "An item left the inventory.",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "item_removed"},
        "itemId": {"description": "The item's id.", "type": "integer"},
        "fullType": {"description": "The item's full type.", "type": "string"}
      },
      "required": ["itemId", "fullType"]
    },
    "event_door": {
      "description": "A door changed state, read off the map's records: a scanned square, or the watch's 6-tile ring round the player on the player's floor. The watch steps at 10 Hz over the ring, so the event can lag up to about 2.3 s standing still, one watch cycle (132 ticks) and the next frame's drain; longer while moving (the ring re-centres every step) or when the square's last delta is under 30 ticks old (held one more cycle).",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "door"},
