    "event_death": {
      "description": "The agent's own player died (PZA/1.3, ruling P23-AO): sent once per player object, on the first events read after the client's OnPlayerDeath hook named that player or its isDead read true, whichever came first; the frames go on after it. The client's health copy is no death signal in multiplayer (it can freeze above 0 on the dead character), so a reader stops on this event.",
      "x-role": "event",
      "properties": {
        "event": {"description": "The event's kind.", "const": "death"},
