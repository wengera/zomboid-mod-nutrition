[
  {
    "name": "walkTo",
    "description": "Walk the vanilla path to a world position at a gait.",
    "input_schema": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "The target world x in tiles."
        },
        "y": {
          "type": "number",
          "description": "The target world y in tiles."
        },
        "gait": {
          "type": "string",
          "enum": [
            "walk",
            "run",
            "sprint"
          ],
          "description": "The gait to move at.",
          "default": "walk"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "steer",
    "description": "Move along a world vector for a time, without a path, at a gait.",
    "input_schema": {
      "type": "object",
      "properties": {
        "vx": {
          "type": "number",
          "description": "The world vector's x component."
        },
        "vy": {
          "type": "number",
          "description": "The world vector's y component."
        },
        "seconds": {
          "type": "number",
          "description": "How long to steer in seconds."
        },
        "gait": {
          "type": "string",
          "enum": [
            "walk",
            "run",
            "sprint"
          ],
          "description": "The gait to move at.",
          "default": "walk"
        }
      },
      "required": [
        "vx",
        "vy",
        "seconds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "attack",
    "description": "One swing at the target: done when the swing ends; read `result.attackStarted` and the target's health in the next frame; a target out of reach is approached first within the skill's budget, else `out of reach`.",
    "input_schema": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "integer",
          "description": "The zombie's online id."
        }
      },
      "required": [
        "targetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "interact",
    "description": "Open or close the door or window on a square, or loot its containers.",
    "input_schema": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "description": "The square's x."
        },
        "y": {
          "type": "integer",
          "description": "The square's y."
        },
        "kind": {
          "type": "string",
          "enum": [
            "open",
            "close",
            "loot"
          ],
          "description": "What to do."
        },
        "filter": {
          "type": "string",
          "enum": [
            "food",
            "water",
            "weapon",
            "bandage",
            "all"
          ],
          "description": "Which items a loot takes.",
          "default": "all"
        },
        "maxWeight": {
          "type": "number",
          "description": "A loot stops before the carried weight would pass this; 0 for no cap.",
          "default": 0
        }
      },
      "required": [
        "x",
        "y",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "equip",
    "description": "Equip an inventory item in the primary hand.",
    "input_schema": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "integer",
          "description": "The item's id."
        }
      },
      "required": [
        "itemId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "consume",
