    "input_schema": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "integer",
          "description": "The item's id."
        }
      },
      "required": [
        "itemId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "drop",
    "description": "Drop an inventory item on the player's square.",
    "input_schema": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "integer",
          "description": "The item's id."
        }
      },
      "required": [
        "itemId"
      ],
      "additionalProperties": false
    }
  },
  {
